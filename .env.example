# Supabase (browser-safe values only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server and worker only — never expose this value to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Any OpenAI-compatible Responses API provider
AI_ENABLED=true
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_MAX_OUTPUT_TOKENS=4000
AI_WEB_SEARCH_ENABLED=true

# Product configuration
APP_NAME=SkillOS
API_RATE_LIMIT_PER_MINUTE=60
UPLOAD_RATE_LIMIT_PER_MINUTE=10
MAX_UPLOAD_MB=20
FEATURE_CRAM_MODE=true
FEATURE_DEEP_LEARN=true
FEATURE_PDF_INGESTION=true
WORKER_NAME=skillos-worker
